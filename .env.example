# ═══ 自选股 ═══
# 逗号分隔，无空格
STOCK_LIST=002410,510300

# ═══ AI 模型 ═══
# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
LITELLM_MODEL=deepseek/deepseek-chat

# ═══ 通知目标 ═══
# QQ 机器人推送目标（必填）
QQ_TARGET=qqbot:c2c:your_qq_user_openid
# 企业微信推送目标（可选）
WX_TARGET=your_wechat_openid
WX_ACCOUNT=your_wechat_bot_account

# ═══ 运行配置 ═══
SCHEDULE_TIME=18:00
REPORT_LANGUAGE=zh

# ═══ 数据源 ═══
# Tushare Token（可选）
TUSHARE_TOKEN=
# 聚宽 JQData（可选）
JQD_PHONE=your_phone_number
JQD_PWD=your_jqdata_password
